{
  "name": "kdd-portal",
  "displayName": "KDD Portal",
  "description": "Portal del área de Tesorería en VS Code: chat por equipo (Google Grupos), formaciones (Calendar + Sheets) y Knowledge Base (Copilot). Versión DEMO con datos simulados.",
  "version": "0.7.0",
  "publisher": "kdd-demo",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kddPortal.open",
        "title": "Abrir KDD Portal",
        "category": "KDD Portal"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kddPortal",
          "title": "KDD Portal",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "kddPortal": [
        {
          "id": "kddPortal.home",
          "name": "Portal"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kddPortal.home",
        "contents": "Hub del área de Tesorería: chat de equipos, formaciones y Knowledge Base.\n[Abrir KDD Portal](command:kddPortal.open)\nVersión demo con datos simulados."
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
